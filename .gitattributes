* text=auto

# Project-authored text uses one repository line-ending policy.
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.cs text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.hlsl text eol=lf
*.shader text eol=lf
*.asmdef text eol=lf
*.json text eol=lf
*.md text eol=lf
*.meta text eol=lf

# Unity YAML assets remain mergeable through UnityYAMLMerge.
*.anim text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.mat text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.unity text eol=lf merge=unityyamlmerge

# Binary assets must never be normalized as text.
*.aiff binary
*.bmp binary
*.dll binary
*.exr binary
*.fbx binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.mp3 binary
*.mp4 binary
*.ogg binary
*.pdf binary
*.png binary
*.psd binary
*.tga binary
*.wav binary
